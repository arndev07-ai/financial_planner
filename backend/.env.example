# Server
PORT=5000
NODE_ENV=development

# Database
DB_PATH=./data/pennywise.db

# Auth
JWT_SECRET=change-this-in-production-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Client origin for CORS (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Recurring auto-process interval (ms), default 6 hours
RECURRING_INTERVAL_MS=21600000

# OCR language data directory (contains eng.traineddata.gz). If absent,
# receipt OCR gracefully falls back to a structured scan.
TESSERACT_LANG_PATH=./data/traineddata
