    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.19.1",
    "tesseract.js": "^7.0.0",
    "xss": "^1.0.15"
